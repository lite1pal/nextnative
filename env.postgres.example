# Local PostgreSQL (Docker)
DATABASE_URL="postgresql://nextnative:nextnative@localhost:5432/nextnative_dev?schema=public"

# ETL source/target
MONGODB_URL="mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority"
MONGODB_DB_NAME="<mongo_db_name>"
POSTGRES_URL="postgresql://nextnative:nextnative@localhost:5432/nextnative_dev?schema=public"
